# --- OpenRouter (LLM) ---  ← pega tu clave de https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Browser ---
STAGEHAND_ENV=LOCAL
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Carpeta de perfil DEDICADA para stephy (no compartir con stagehand-amazon).
CHROME_USER_DATA_DIR=C:\Users\MMS Server\Desktop\MamaSAN\Stagehand\stagehand-stephy\chrome-user-data

# --- StephyTracking ---
STEPHY_URL=https://app.stephytracking.com/
STEPHY_COMPANY=tecnoship
STEPHY_ROLE=Agente
STEPHY_USER=
STEPHY_PASSWORD=

# --- Correo de registro de corrida (opcional) ---
# Webhook n8n que manda el log completo de cada corrida a moises@mamasan.app.
# Si se omite, se usa el valor por defecto del código.
ENVIAR_LOG_WEBHOOK_URL=https://n8n-n8n.40j1oe.easypanel.host/webhook/enviar-log-stephy

# --- Telemetría de corridas → Supabase (opcional) ---
# Webhook n8n que registra cada corrida en corridas_tracking_stephy +
# auditoria_tracking_stephy (dashboard v_bot_salud). Si se omite, usa el default.
REGISTRAR_CORRIDA_WEBHOOK_URL=https://n8n-n8n.40j1oe.easypanel.host/webhook/registrar-corrida-stephy
# Poner en 0 para NO registrar (corridas dev/manual que no deben ensuciar métricas).
STEPHY_TELEMETRY=1
# Costo LLM: por defecto se estima con los precios de OpenRouter (/api/v1/models).
# Override opcional en USD por 1M de tokens (entrada / salida) si prefieres fijarlo:
# OPENROUTER_PRICE_IN=0.30
# OPENROUTER_PRICE_OUT=2.50
