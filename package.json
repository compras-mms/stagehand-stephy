{
  "name": "stagehand-stephy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated StephyTracking (Tecnoship) sign-in with Stagehand (local Chrome + OpenRouter). Shares the 'Mama SAN Amazon' Supabase DB.",
  "scripts": {
    "smoke": "tsx src/smoke.ts",
    "preflight": "tsx src/preflight.ts",
    "stephy": "tsx src/stephy-login.ts",
    "stephy:preview": "cross-env STEPHY_SEARCH=1 STEPHY_PREVIEW=1 tsx src/stephy-login.ts",
    "stephy:auto": "cross-env STEPHY_AUTORUN=1 STEPHY_SEARCH=1 tsx src/stephy-login.ts",
    "stephy:manual": "cross-env STEPHY_MANUAL_LOGIN=1 STEPHY_SEARCH=1 tsx src/stephy-login.ts",
    "stephy:consignee": "cross-env STEPHY_CONSIGNEE=1 STEPHY_CONSIGNEE_FILE=data/receipts-contaminados.json tsx src/stephy-login.ts",
    "stephy:consignee:manual": "cross-env STEPHY_MANUAL_LOGIN=1 STEPHY_CONSIGNEE=1 STEPHY_CONSIGNEE_FILE=data/receipts-contaminados.json tsx src/stephy-login.ts",
    "inspect": "tsx src/inspect-dom.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3",
    "@openrouter/ai-sdk-provider": "^1",
    "dotenv": "^17",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "cross-env": "^7.0.3",
    "tsx": "^4",
    "typescript": "^5"
  }
}
